# secrets.toml 템플릿
#
# Streamlit은 프로젝트 로컬 → 사용자 전역 순으로 secrets를 찾는다.
#
#   운영(권장):  ~/.streamlit/secrets.toml
#                저장소 밖이라 브랜치 전환·워크트리 생성에도 자격증명이 유지된다.
#                  mkdir -p ~/.streamlit
#                  cp .streamlit/secrets.toml.example ~/.streamlit/secrets.toml
#                  chmod 600 ~/.streamlit/secrets.toml
#
#   테스트:      <프로젝트>/.streamlit/secrets.toml
#                존재하면 전역보다 우선한다. .gitignore 대상이라 커밋되지 않는다.

[gcp_service_account]
# 다운로드한 서비스 계정 JSON 키의 각 필드를 그대로 복사한다.
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

[spreadsheet]
# 생성한 Google Sheets 스프레드시트 이름과 동일하게 입력
name = "스프레드시트 이름"

[admin]
# Members 시트에 등록된 관리자 이름과 동일하게 입력
name = "관리자 이름"
# SSO가 걸려있지 않으므로 충분히 강한 값을 사용할 것
password = "관리자 비밀번호"

# ---------------------------------------------------------------------------
# SCRAPER_API_KEY (ScrapingBee) — 사내 컨테이너 호스팅에서는 설정하지 않는다.
#
# 이 키가 없으면 utils/scraper.py가 자동으로 Yes24 직접 요청(direct 모드)으로
# 동작한다. 사내 컨테이너는 국내 IP라 직접 접근이 정상이므로 우회가 불필요하다.
# Yes24가 향후 이 IP까지 차단할 경우에만 폴백으로 값을 채운다.
#
# SCRAPER_API_KEY = ""
# ---------------------------------------------------------------------------
